---
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/layouts/Header.astro";
import { formatRupiah } from "@/lib/formatter";
import { getServerToken } from "@/lib/auth";

export const prerender = false;

interface Attribute {
  source: string;
  description: string;
  title: string;
  source_from: string;
  type: string;
}

interface EventData {
  attributes: Attribute[];
  id: string;
  datetime: string;
  description: string;
  due_duetime: string;
  image: string;
  mitra: { name: string; image: string };
  location: string | null;
  link: string;
  mode: string;
  price: string;
  summary: string;
  title: string;
  confirmed_quota: number;
  quota: number;
  type: { name: string };
  is_registered: boolean;
  status: string;
  reg_only: number | null;
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/");

const token = getServerToken(Astro.cookies);
const API_URL = import.meta.env.ASTRO_API_URL;

const fetchEvent = async (): Promise<EventData | null> => {
  try {
    const res = await fetch(`${API_URL}/event/link/${slug}`, {
      headers: {
        Accept: "application/json",
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    });
    if (!res.ok) return null;
    const json = await res.json();
    return json?.data ?? null;
  } catch {
    return null;
  }
};

const eventData = await fetchEvent();
if (!eventData) return Astro.redirect("/404");

// Derive values di server
const isRegistered = !!eventData.is_registered;
const isActive = eventData.status === "active";
const isButtonDisabled = isRegistered || !isActive;
const isEventType = eventData.type.name === "Event";
const regOnly = eventData.reg_only ?? 0;
const priceNum = Number(eventData.price) || 0;

const dateInfo = new Date(eventData.datetime).toLocaleDateString("id-ID", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
const typeInfo = `${eventData.type.name} ${eventData.mode}`;

const buttonText = !isActive
  ? `${eventData.type.name} telah berakhir`
  : isRegistered
    ? "Anda sudah terdaftar"
    : `Daftar ${eventData.type.name}`;
---

<MainLayout
  title={eventData.title}
  description={eventData.summary || eventData.title}
>
  <Header type="title" text={eventData.title} link="/" />

  <main class="min-h-screen">
    <div class="container bg-white">
      <!-- Hero -->
      <img
        src={eventData.image}
        alt={eventData.title}
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
        class="w-full h-auto object-cover"
      />

      <div class="px-4 py-4 space-y-5">
        <!-- Title -->
        <h1 class="font-bold text-xl text-gray-900 leading-tight">
          {eventData.title}
        </h1>

        <!-- Organizer -->
        <div
          class="rounded-xl border border-gray-100 shadow-sm p-4 flex gap-3 items-center"
        >
          <img
            src={eventData.mitra.image}
            alt={eventData.mitra.name}
            width="56"
            height="56"
            loading="lazy"
            decoding="async"
            class="rounded-xl object-cover w-14 h-14 flex-shrink-0"
          />
          <div class="min-w-0">
            <p class="text-[11px] text-gray-400 mb-0.5">Diselenggarakan oleh</p>
            <p class="font-semibold text-sm text-gray-900 truncate">
              {eventData.mitra.name}
            </p>
          </div>
        </div>

        <!-- Informasi Event -->
        <div>
          <p class="text-xs font-semibold text-gray-500 mb-3">
            INFORMASI EVENT
          </p>
          <div class="grid grid-cols-1 gap-3">
            <!-- Waktu & Tanggal -->
            <div
              class="border border-gray-100 shadow-sm rounded-lg p-3.5 flex gap-3 items-center"
            >
              <div
                class="w-10 h-10 rounded-xl bg-primary-50 text-primary-500 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-gray-400 mb-0.5">Waktu & Tanggal</p>
                <p class="text-sm font-semibold text-gray-900 truncate">
                  {dateInfo}
                </p>
              </div>
            </div>

            <!-- Jenis -->
            <div
              class="border border-gray-100 shadow-sm rounded-lg p-3.5 flex gap-3 items-center"
            >
              <div
                class="w-10 h-10 rounded-xl bg-primary-50 text-primary-500 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
                  ></path>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-gray-400 mb-0.5">Jenis Event</p>
                <p class="text-sm font-semibold text-gray-900 truncate">
                  {typeInfo}
                </p>
              </div>
            </div>

            <!-- Lokasi -->
            {
              eventData.location && (
                <div class="border border-gray-100 shadow-sm rounded-lg p-3.5 flex gap-3 items-center">
                  <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-500 flex items-center justify-center flex-shrink-0">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      class="w-5 h-5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                      />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-[11px] text-gray-400 mb-0.5">Lokasi Event</p>
                    <p class="text-sm font-semibold text-gray-900 truncate">
                      {eventData.location}
                    </p>
                  </div>
                </div>
              )
            }

            <!-- Peserta -->
            {
              !!eventData.quota && (
                <div class="border border-gray-100 shadow-sm rounded-lg p-3.5 flex gap-3 items-center">
                  <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-500 flex items-center justify-center flex-shrink-0">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      class="w-5 h-5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"
                      />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-[11px] text-gray-400 mb-0.5">Peserta</p>
                    <p class="text-sm font-semibold text-gray-900 truncate">
                      {eventData.confirmed_quota}/{eventData.quota}
                    </p>
                  </div>
                </div>
              )
            }
          </div>
        </div>

        <!-- Tentang Event -->
        <div>
          <p class="text-xs font-semibold text-gray-500 mb-3">TENTANG EVENT</p>
          <div class="rounded-lg border border-gray-100 shadow-sm p-4">
            <div
              class="prose prose-sm max-w-none text-sm text-gray-700 leading-relaxed"
              set:html={eventData.description}
            />
          </div>
        </div>

        <!-- Mulai Kelas -->
        {
          eventData.attributes.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-gray-500 mb-3">
                MULAI KELAS
              </p>
              <div class="flex flex-col gap-2">
                {eventData.attributes.map((attribute, idx) => {
                  const accessible = isRegistered || idx === 0;
                  const isVideo = attribute.type === "video";
                  const isUrl = attribute.source_from === "url";

                  return (
                    <Fragment>
                      {accessible ? (
                        <a
                          href={attribute.source}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="rounded-lg border border-gray-100 shadow-sm p-3.5 flex justify-between items-center gap-3 hover:border-primary-200 active:scale-[0.99] transition-all"
                        >
                          <div class="flex gap-3 items-center min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-500 flex items-center justify-center flex-shrink-0">
                              {isVideo ? (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="2"
                                  stroke="currentColor"
                                  class="w-5 h-5"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z"
                                  />
                                </svg>
                              ) : isUrl ? (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="2"
                                  stroke="currentColor"
                                  class="w-5 h-5 "
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"
                                  />
                                </svg>
                              ) : (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="2"
                                  stroke="currentColor"
                                  class="w-5 h-5"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                                  />
                                </svg>
                              )}
                            </div>
                            <p class="text-sm font-semibold text-gray-900 truncate">
                              {attribute.title}
                            </p>
                          </div>
                          <div class="w-9 h-9 rounded-xl bg-primary-500 text-white flex items-center justify-center flex-shrink-0">
                            {isVideo ? (
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-4 h-4"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z"
                                />
                              </svg>
                            ) : (
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-4 h-4 -rotate-45"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                />
                              </svg>
                            )}
                          </div>
                        </a>
                      ) : (
                        <div class="bg-gray-50 rounded-lg border border-gray-100 p-3.5 flex justify-between items-center gap-3 opacity-70 cursor-not-allowed">
                          <div class="flex gap-3 items-center min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-gray-200 text-gray-400 flex items-center justify-center flex-shrink-0">
                              {isVideo ? (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="2"
                                  stroke="currentColor"
                                  class="w-5 h-5"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z"
                                  />
                                </svg>
                              ) : isUrl ? (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="2"
                                  stroke="currentColor"
                                  class="w-5 h-5"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"
                                  />
                                </svg>
                              ) : (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="2"
                                  stroke="currentColor"
                                  class="w-5 h-5"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                                  />
                                </svg>
                              )}
                            </div>
                            <p class="text-sm font-medium text-gray-500 truncate">
                              {attribute.title}
                            </p>
                          </div>
                          <div class="w-9 h-9 rounded-xl bg-gray-200 text-gray-400 flex items-center justify-center flex-shrink-0">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke-width="2"
                              stroke="currentColor"
                              class="w-4 h-4"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                              />
                            </svg>
                          </div>
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>
            </div>
          )
        }
        <div class="h-56 bg-white"></div>
      </div>
    </div>
  </main>

  <!-- Fixed bottom -->
  <div
    class="fixed container bottom-0 left-0 right-0 z-30 bg-white border-t border-gray-100 px-4 py-4"
    data-event
    data-event-id={eventData.id}
    data-event-link={eventData.link}
    data-event-title={eventData.title}
    data-event-image={eventData.image}
    data-event-date={dateInfo}
    data-event-type={typeInfo}
    data-event-type-name={eventData.type.name}
    data-event-price={String(priceNum)}
    data-reg-only={String(regOnly)}
    data-disabled={String(isButtonDisabled)}
    data-is-event-type={String(isEventType)}
  >
    <div>
      <!-- Ticket form (hidden by default) -->
      <div id="ticket-form" class="hidden mb-4 flex flex-col gap-3">
        <div class="flex justify-between items-center">
          <h4 class="font-semibold text-sm text-gray-900">Detail Pembelian</h4>
          <button
            type="button"
            id="close-ticket-form"
            class="p-1 rounded-lg hover:bg-gray-100 transition-colors"
            aria-label="Tutup"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 text-gray-500"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        {
          isEventType && (
            <>
              <div class="bg-gray-50 rounded-xl border border-gray-100 px-3 py-2.5 flex justify-between items-center">
                <span class="text-sm text-gray-600">Harga Tiket</span>
                <span class="text-sm font-semibold text-gray-900">
                  {formatRupiah(priceNum)}
                </span>
              </div>

              <div class="bg-gray-50 rounded-xl border border-gray-100 px-3 py-2.5 flex justify-between items-center">
                <span class="text-sm text-gray-600">Jumlah Tiket</span>
                <div class="flex items-center gap-3">
                  <button
                    type="button"
                    id="ticket-minus"
                    class="w-8 h-8 flex items-center justify-center bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-primary-400 hover:bg-primary-50 disabled:opacity-40 disabled:cursor-not-allowed transition-all"
                    aria-label="Kurangi"
                  >
                    −
                  </button>
                  <span
                    id="ticket-count"
                    class="font-semibold text-base text-gray-900 min-w-[2ch] text-center"
                  >
                    1
                  </span>
                  <button
                    type="button"
                    id="ticket-plus"
                    class="w-8 h-8 flex items-center justify-center bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-primary-400 hover:bg-primary-50 disabled:opacity-40 disabled:cursor-not-allowed transition-all"
                    aria-label="Tambah"
                  >
                    +
                  </button>
                </div>
              </div>
            </>
          )
        }

        <div
          class="bg-primary-50 rounded-xl border border-primary-100 px-3 py-2.5 flex justify-between items-center"
        >
          <span class="text-sm font-semibold text-gray-700">Total Harga</span>
          <span id="total-price" class="text-base font-bold text-primary-600"
            >{formatRupiah(priceNum)}</span
          >
        </div>

        {
          isEventType && (
            <p class="text-[11px] text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
              Maksimal 5 tiket per akun
            </p>
          )
        }
      </div>

      <button
        type="button"
        id="action-button"
        class:list={[
          "w-full font-semibold py-3 rounded-lg transition-all duration-150",
          isButtonDisabled
            ? "bg-gray-200 text-gray-500 cursor-not-allowed"
            : "bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white",
        ]}
        disabled={isButtonDisabled}
      >
        {buttonText}
      </button>
    </div>
  </div>
</MainLayout>

<script>
  import { formatRupiah } from "@/lib/formatter";

  const section = document.querySelector("[data-event]") as HTMLElement | null;
  const button = document.getElementById(
    "action-button",
  ) as HTMLButtonElement | null;
  const ticketForm = document.getElementById(
    "ticket-form",
  ) as HTMLElement | null;
  const ticketCountEl = document.getElementById(
    "ticket-count",
  ) as HTMLElement | null;
  const totalPriceEl = document.getElementById(
    "total-price",
  ) as HTMLElement | null;
  const minusBtn = document.getElementById(
    "ticket-minus",
  ) as HTMLButtonElement | null;
  const plusBtn = document.getElementById(
    "ticket-plus",
  ) as HTMLButtonElement | null;
  const closeBtn = document.getElementById(
    "close-ticket-form",
  ) as HTMLButtonElement | null;

  if (section && button) {
    const {
      eventId = "",
      eventLink = "",
      eventTitle = "",
      eventImage = "",
      eventDate = "",
      eventType = "",
      eventTypeName = "",
      eventPrice = "0",
      regOnly = "0",
      disabled = "false",
    } = section.dataset;

    const priceNum = Number(eventPrice) || 0;
    const regOnlyNum = Number(regOnly) || 0;
    const isDisabled = disabled === "true";

    let ticketCount = 1;
    let getTicketMode = false;

    const updateDisplay = () => {
      if (ticketCountEl) ticketCountEl.textContent = String(ticketCount);
      if (totalPriceEl)
        totalPriceEl.textContent = formatRupiah(priceNum * ticketCount);
      if (minusBtn) minusBtn.disabled = ticketCount <= 1;
      if (plusBtn) plusBtn.disabled = ticketCount >= 5;
    };

    const submit = () => {
      const formData = {
        id: eventId,
        title: eventTitle,
        image: eventImage,
        date: eventDate,
        type: eventType,
        qty: ticketCount,
        price: String(priceNum),
        totalPrice: priceNum * ticketCount,
        reg_only: regOnlyNum,
      };
      sessionStorage.setItem("eventFormData", JSON.stringify(formData));
      window.location.href = `/event/form/${eventLink}/`;
    };

    minusBtn?.addEventListener("click", () => {
      if (ticketCount > 1) {
        ticketCount--;
        updateDisplay();
      }
    });

    plusBtn?.addEventListener("click", () => {
      if (ticketCount < 5) {
        ticketCount++;
        updateDisplay();
      }
    });

    closeBtn?.addEventListener("click", () => {
      getTicketMode = false;
      ticketCount = 1;
      ticketForm?.classList.add("hidden");
      button.textContent = `Daftar ${eventTypeName}`;
      updateDisplay();
    });

    button.addEventListener("click", () => {
      if (isDisabled) return;

      // reg_only !== 0 → langsung submit tanpa buka form
      if (regOnlyNum !== 0) {
        submit();
        return;
      }

      // Form sudah tampil → submit
      if (getTicketMode) {
        submit();
        return;
      }

      // Tampilkan ticket form
      getTicketMode = true;
      ticketForm?.classList.remove("hidden");
      button.textContent = "Bayar Sekarang";
      updateDisplay();
    });
  }
</script>
